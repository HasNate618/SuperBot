{
  "include": ["clank", "tests", "spike"],
  "exclude": ["**/vendor/**", "**/__pycache__/**", "spike/e2/frames/**"],
  "venvPath": "spike/e3",
  "venv": ".venv",
  "pythonVersion": "3.13",
  "typeCheckingMode": "basic",
  "reportMissingImports": "error",
  "extraPaths": ["."],
  "overrides": [
    {
      "include": ["spike/wbc/**", "spike/c0/**"],
      "reportAttributeAccessIssue": "none",
      "reportArgumentType": "none"
    }
  ]
}
